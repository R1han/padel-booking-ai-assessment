# Copy to .env and fill in. The app boots without any of these; only model calls need keys.

# --- model access -------------------------------------------------------------
OPENAI_API_KEY=sk-proj...
ANTHROPIC_API_KEY=sk-ant....

# --- model abstraction --------------------------------------------------------
LLM_PLANNER=openai:gpt-4.1-mini
LLM_RERANKER=openai:gpt-4.1-mini
LLM_ANSWERER=openai:gpt-4.1-mini
LLM_FALLBACK=anthropic:claude-haiku-4-5-20251001
EMBEDDING_MODEL=text-embedding-3-small

# --- tracing ------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_.....
LANGSMITH_PROJECT=baseline-padel
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- server -------------------------------------------------------------------
PORT=3000

# --- retrieval ----------------------------------------------------------------
RETRIEVAL_TOP_K=20
RERANK_TOP_K=6
RERANK_ENABLED=true

# --- domain -------------------------------------------------------------------
# What "today" means. Defaults to dataset_meta.json (2026-08-09) so "tomorrow"
# resolves inside the 2026-08-10..2026-08-24 availability window on any real date.
# REFERENCE_DATE=2026-08-09

# --- booking ------------------------------------------------------------------
HOLD_TTL_SECONDS=180
BOOKING_ENFORCE_LEGACY_OVERHANG=true
